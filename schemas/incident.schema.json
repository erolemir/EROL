{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EROL verified incident input v1",
  "type": "object",
  "required": ["id", "task_id", "symptom", "error", "component", "root_cause", "solution", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "symptom": {"type": "string", "minLength": 1, "maxLength": 16000},
    "error": {"type": "string", "minLength": 1, "maxLength": 16000},
    "component": {"type": "string", "minLength": 1, "maxLength": 16000},
    "root_cause": {"type": "string", "minLength": 1, "maxLength": 16000},
    "solution": {"type": "string", "minLength": 1, "maxLength": 16000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
    "exception": {"type": "string", "maxLength": 1000},
    "root_category": {"type": "string", "maxLength": 1000},
    "regression_risk": {"type": "string", "maxLength": 1000},
    "files": {"type": "array", "items": {"type": "string"}},
    "verification": {"$ref": "verification.schema.json"}
  }
}
