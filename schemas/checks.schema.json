{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EROL execution checks v1",
  "type": "object",
  "required": ["schema_version", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "contains": {"type": "object", "properties": {"kind": {"const": "acceptance"}}, "required": ["kind"]},
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "argv", "timeout_seconds"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
          "kind": {"enum": ["acceptance", "static"]},
          "argv": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        }
      }
    }
  },
  "$comment": "Runtime also rejects duplicate names, NUL arguments, secret-like content and Windows shell wrappers. Checks are explicitly reviewed executable commands, not a sandbox."
}
