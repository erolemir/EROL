{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EROL configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "learning_enabled": {"type": "boolean", "default": true},
    "minimum_pattern_occurrences": {"type": "integer", "minimum": 2, "maximum": 100000, "default": 3},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
    "project_skill_activation": {"type": "boolean", "default": true},
    "global_auto_promotion": {"const": false, "default": false},
    "context_tokens": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 4000},
    "max_active_skills": {"type": "integer", "minimum": 1, "maximum": 6, "default": 4},
    "max_skill_chars": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 12000},
    "minimum_successful_uses": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 3},
    "maximum_false_trigger_rate": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.1}
  }
}
