{
  "name": "erol",
  "version": "0.2.3",
  "description": "Extensible Reasoning & Orchestration Layer: local project memory and evidence-gated learning",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erolemir/EROL.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "erol": "bin/erol.mjs"
  },
  "scripts": {
    "test": "node --test tests/node/launcher.test.mjs tests/node/panel.test.mjs"
  },
  "files": [
    "bin/erol.mjs",
    "bin/erol.py",
    "src/erol/**/*.py",
    "src/erol/data/**/*.json",
    "src/erol/data/**/*.md",
    "src/erol/data/**/*.png",
    "plugins/erol/plugin.json",
    "plugins/erol/LICENSE",
    "plugins/erol/COPYRIGHT",
    "scripts/update-plugins.ps1",
    "plugins/erol/.claude-plugin/plugin.json",
    "plugins/erol/skills/**/*",
    "plugins/erol/scripts/*.mjs",
    "plugins/erol/scripts/*.py",
    "plugins/erol/runtime/erol/**/*.py",
    "plugins/erol/runtime/erol/data/**/*.json",
    "plugins/erol/runtime/erol/data/**/*.md",
    "plugins/erol/runtime/erol/data/**/*.png",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "adapters/**/*.md",
    "docs/**/*.md",
    "schemas/**/*.json",
    "examples/**/*.json",
    "README.md",
    "LICENSE",
    "COPYRIGHT",
    "CHANGELOG.md",
    "SECURITY.md"
